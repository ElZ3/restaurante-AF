<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Si la petición no es un archivo ni carpeta física existente
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    
    # Redirigir todo al Front Controller (index.php)
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>